{
  "name": "aios-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aios Sentinel — 連動 aios 網站／App／桌面三端的錯誤、資訊安全與頁面檢測系統",
  "bin": {
    "aios-sentinel": "./src/cli.ts"
  },
  "scripts": {
    "sentinel": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "pages": "tsx src/cli.ts pages",
    "shells": "tsx src/cli.ts shells",
    "monitor": "tsx src/cli.ts monitor",
    "all": "tsx src/cli.ts all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "browsers:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
